# =====================================================
# Realtime Chat App — environment variables
# Copy to .env.local and fill in values as each phase requires.
# Never commit .env files. See docs/authentication.md.
# =====================================================

# --- App ---
# Public origin of the app. Used for links in emails/notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Database, Auth, Realtime, Storage) ---
# Project URL, e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable key — safe to expose to the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy public anon key (supported for backward compatibility)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string — server-side only (migrations/scripts).
SUPABASE_DB_URL=

# --- Upstash Redis (Cache, rate limiting, idempotency) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (Message queue) ---
QSTASH_TOKEN=
QSTASH_SIGNING_KEY=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
