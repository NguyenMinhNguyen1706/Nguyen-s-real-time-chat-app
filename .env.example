# =====================================================
# Realtime Chat App — environment variables
# Copy to .env.local and fill in values as each phase requires.
# Never commit .env files. See docs/security/authentication.md.
# =====================================================

# --- App ---
# Public origin of the app. Used for links in emails/notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 2: database, Phase 3: auth) ---
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe to expose to the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string — server-side only (migrations/scripts).
SUPABASE_DB_URL=

# --- Upstash Redis (Phase 8: cache, rate limiting, idempotency) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (Phase 10: message queue) ---
QSTASH_TOKEN=
# Signing key used to verify incoming QStash webhook signatures.
QSTASH_SIGNING_KEY=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
